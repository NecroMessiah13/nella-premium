# App
APP_URL="http://localhost:3000"

# Cookie security. Set "true" when served over HTTPS.
# "false" (or unset in dev) allows cookies over HTTP (e.g. local Docker on :3000).
# In production over HTTPS this should be "true".
COOKIE_SECURE="false"
